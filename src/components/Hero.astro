---
---

<section class="relative overflow-hidden bg-gradient-to-br from-base-50 via-white to-blue-50">
  <div class="max-w-5xl mx-auto px-4 py-20 md:py-28 text-center">
    <!-- Icon -->
    <img
      src="/b-sky-lab/images/icon_mini.jpg"
      alt="B-SKY Lab"
      class="w-24 h-24 rounded-full mx-auto mb-6 border-2 border-base-200 shadow-md"
    />

    <!-- Site Name -->
    <h1 class="text-4xl md:text-5xl font-bold text-base-800 mb-4">
      B-SKY Lab
    </h1>

    <!-- Catchcopy -->
    <p class="text-lg md:text-xl text-base-500 mb-8 max-w-xl mx-auto">
      ロボティクスエンジニアのポートフォリオ &amp; 技術ブログ
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/b-sky-lab/portfolio.html"
        class="inline-flex items-center gap-2 bg-accent hover:bg-accent-dark text-white font-medium px-6 py-3 rounded-lg transition-colors no-underline"
      >
        Portfolio
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href="/b-sky-lab/about.html"
        class="inline-flex items-center gap-2 border border-base-300 hover:border-accent text-base-700 hover:text-accent font-medium px-6 py-3 rounded-lg transition-colors no-underline"
      >
        About
      </a>
    </div>
  </div>

  <!-- Decorative element -->
  <div class="absolute -bottom-1 left-0 right-0 h-8 bg-gradient-to-t from-base-50 to-transparent"></div>
</section>
