---
const events = [
  { year: '2018', title: '大学でロボティクスを専攻', description: 'ロボット工学・制御工学を学び、研究室で移動ロボットの制御に携わる' },
  { year: '2020', title: '組込みエンジニアとして就職', description: 'ロボット関連企業で組込みソフトウェア開発に従事' },
  { year: '2021', title: 'B-SKY Lab 活動開始', description: '個人でのロボット制作・技術発信をスタート。ブログ・SNSでの情報共有を開始' },
  { year: '2022', title: 'Maker Faire Tokyo 出展', description: 'ヘビ型ロボットなどの自作ロボットを出展、多くの来場者と交流' },
  { year: '2023', title: 'フリーランスとして独立', description: 'ロボティクスを中心としたフリーランスエンジニアとして活動を開始' },
  { year: '現在', title: 'ロボティクスエンジニアとして活動中', description: 'ロボット開発・基板設計・技術コンサルティングなど幅広く活動' },
];
---

<section class="py-12">
  <h2 class="text-xl font-bold text-base-800 mb-6 border-b border-base-200 pb-2">Timeline</h2>

  <div class="relative pl-8 border-l-2 border-base-200 space-y-8">
    {events.map(({ year, title, description }) => (
      <div class="relative">
        {/* Dot */}
        <div class="absolute -left-[calc(2rem+5px)] w-3 h-3 rounded-full bg-accent border-2 border-white shadow-sm" />

        {/* Content */}
        <div>
          <span class="inline-block text-xs font-semibold text-accent bg-blue-50 rounded-full px-2 py-0.5 mb-1">
            {year}
          </span>
          <h3 class="text-base font-semibold text-base-800">{title}</h3>
          <p class="text-sm text-base-500 mt-1">{description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
