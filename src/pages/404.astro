---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 Not Found">
  <div class="max-w-5xl mx-auto px-4 py-24 text-center">
    <p class="text-6xl font-bold text-accent mb-4">404</p>
    <h1 class="text-2xl font-bold text-base-800 mb-4">ページが見つかりません</h1>
    <p class="text-base-500 mb-8">お探しのページは移動または削除された可能性があります。</p>
    <a
      href="/b-sky-lab/"
      class="inline-block px-6 py-3 bg-accent text-white font-medium rounded-lg hover:bg-blue-600 transition-colors no-underline"
    >
      トップページへ戻る
    </a>
  </div>
</BaseLayout>
