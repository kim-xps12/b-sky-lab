---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileSection from '../components/ProfileSection.astro';
import Timeline from '../components/Timeline.astro';
import SnsLinks from '../components/SnsLinks.astro';
---

<BaseLayout title="About" description="B-SKY Lab 運営者のプロフィール・略歴・SNSリンク">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-2xl md:text-3xl font-bold text-base-800 mb-2">About</h1>
    <p class="text-base-500 mb-8">プロフィール・略歴</p>

    <ProfileSection />
    <Timeline />
    <SnsLinks />
  </div>
</BaseLayout>
