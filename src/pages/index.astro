---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PortfolioCard from '../components/PortfolioCard.astro';

// Latest portfolio items (up to 3)
const portfolioItems = (await getCollection('portfolio')).sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;
  if (orderA !== orderB) return orderA - orderB;
  return b.data.date.getTime() - a.data.date.getTime();
}).slice(0, 3);

const snsLinks = [
  { label: 'Twitter / X', handle: '@eternalfriend17', href: 'https://x.com/eternalfriend17', icon: 'x' },
  { label: 'GitHub', handle: 'kim-xps12', href: 'https://github.com/kim-xps12', icon: 'github' },
  { label: 'Qiita', handle: 'B-SKY-Lab', href: 'https://qiita.com/B-SKY-Lab', icon: 'qiita' },
  { label: 'note', handle: 'b_sky_lab', href: 'https://note.com/b_sky_lab', icon: 'note' },
];
---

<BaseLayout>
  <!-- Hero -->
  <Hero />

  <!-- Latest Portfolio -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl md:text-2xl font-bold text-base-800">Portfolio</h2>
      <a href="/b-sky-lab/portfolio.html" class="text-sm text-accent hover:text-accent-dark no-underline font-medium">
        View all &rarr;
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {portfolioItems.map((item) => (
        <PortfolioCard
          title={item.data.title}
          titleEn={item.data.titleEn}
          description={item.data.description}
          thumbnail={item.data.thumbnail}
          slug={item.id.replace(/\.md$/, '')}
          tags={item.data.tags}
        />
      ))}
    </div>
  </section>

  <!-- About & SNS -->
  <section class="bg-base-100">
    <div class="max-w-5xl mx-auto px-4 py-12">
      <div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
        <!-- Mini Profile -->
        <div class="flex-1 text-center md:text-left">
          <div class="flex items-center gap-4 mb-4 justify-center md:justify-start">
            <img src="/b-sky-lab/images/icon_mini.jpg" alt="B-SKY Lab" class="w-16 h-16 rounded-full border border-base-200" />
            <div>
              <h2 class="text-xl font-bold text-base-800">孔明</h2>
              <p class="text-sm text-base-400">Robotics Engineer / Freelance</p>
            </div>
          </div>
          <p class="text-sm text-base-600 leading-relaxed mb-4">
            ロボティクスをメインに活動するフリーランスエンジニア。ロボット制作・基板設計・ガジェット制作が趣味です。
          </p>
          <a href="/b-sky-lab/about.html" class="text-sm text-accent hover:text-accent-dark no-underline font-medium">
            More about me &rarr;
          </a>
        </div>

        <!-- SNS Links -->
        <div class="shrink-0 w-full md:w-auto">
          <h3 class="text-sm font-semibold text-base-500 uppercase tracking-wide mb-3 text-center md:text-left">Links</h3>
          <div class="grid grid-cols-2 gap-3">
            {snsLinks.map(({ label, handle, href, icon }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 p-3 rounded-lg border border-base-200 hover:border-accent hover:shadow-sm transition-all no-underline group"
              >
                <span class="shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-white text-base-400 group-hover:text-accent transition-colors">
                  {icon === 'x' && (
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                    </svg>
                  )}
                  {icon === 'github' && (
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                    </svg>
                  )}
                  {icon === 'qiita' && <span class="text-sm font-bold">Q</span>}
                  {icon === 'note' && <span class="text-sm font-bold">n</span>}
                </span>
                <div class="min-w-0">
                  <span class="block text-sm font-medium text-base-700 group-hover:text-accent transition-colors">{label}</span>
                  <span class="block text-xs text-base-400 truncate">{handle}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
