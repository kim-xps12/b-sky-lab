---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioGrid from '../../components/PortfolioGrid.astro';

const items = await getCollection('portfolio');

// Sort by order (ascending), then by date (descending) as tiebreaker
items.sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;
  if (orderA !== orderB) return orderA - orderB;
  return b.data.date.getTime() - a.data.date.getTime();
});

// Group by category
const categories = [
  { key: 'robot', label: 'Robot' },
  { key: 'board', label: 'Board' },
  { key: 'gadget', label: 'Gadget' },
] as const;

const grouped = categories
  .map(({ key, label }) => ({
    key,
    label,
    items: items.filter((item) => item.data.category === key),
  }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout title="Portfolio" description="B-SKY Lab ポートフォリオ — ロボット・基板・ガジェットの制作実績">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-2xl md:text-3xl font-bold text-base-800 mb-2">Portfolio</h1>
    <p class="text-base-500 mb-10">制作実績 — {items.length} 件</p>

    {grouped.map(({ key, label, items: groupItems }) => (
      <section class="mb-12" id={key}>
        <h2 class="text-xl font-bold text-base-800 mb-6 border-b border-base-200 pb-2">
          {label}
        </h2>
        <PortfolioGrid items={groupItems} />
      </section>
    ))}
  </div>
</BaseLayout>
